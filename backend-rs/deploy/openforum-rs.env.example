# Rust 后端运行环境变量示例（实际文件放在服务器 /root/openforum-build-rs/openforum-rs.env）
# 与 Java 版共用同一个 MySQL 库与 MinIO 桶，因此表结构、数据完全一致。

# ---- 服务 ----
SERVER_PORT=8080

# ---- MySQL（容器网络内主机名）----
DB_URL=jdbc:mysql://openforum-mysql:3306/openforum
DB_USER=root
DB_PASSWORD=root123456

# ---- JWT（必须与 Java 版一致，才能共用同一批令牌）----
JWT_SECRET=openforum-dev-secret-key-change-me-2026-abcdefgh
JWT_EXPIRATION_HOURS=168

# ---- MinIO 媒体存储 ----
MINIO_ENABLED=true
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=openforum-auth

# ---- AI 审核（可选）----
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# ---- Google 登录（可选，需与前端一致）----
GOOGLE_CLIENT_ID=

# ---- 认证中心 ----
AUTH_CHALLENGE_TTL_MINUTES=10
AUTH_MAX_DOCUMENT_COUNT=5
AUTH_MAX_IMAGE_BYTES=10485760
AUTH_MAX_VIDEO_BYTES=52428800
AUTH_AUTO_APPROVE_THRESHOLD=0.85
